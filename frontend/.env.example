# The public site and admin dashboard call the backend through this URL.
#
# Local development: keep http://localhost:4000
#   (your backend runs on port 4000 with `npm run dev:backend`)
#
# Production: set this to your deployed backend (frontend and backend are
# hosted separately), e.g. https://your-backend.onrender.com. Add it as an
# environment variable in your Vercel project settings, then rebuild.
#
# If unset in a production build, the app falls back to same-origin /api,
# which will not reach a separately hosted backend.
VITE_API_URL=http://localhost:4000
